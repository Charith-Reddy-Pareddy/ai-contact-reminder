PORT=4000

# Optional: enables real LLM-generated messages via OpenAI.
# Without this, the app uses a template-based fallback generator.
OPENAI_API_KEY=your_api_key_here

# Optional: restricts CORS to this origin instead of allowing all (*).
# FRONTEND_ORIGIN=https://your-frontend.onrender.com

# Optional: use Postgres instead of the local contacts.json file.
# Without this, contacts are stored in a JSON file that Render's
# free tier wipes on redeploy/restart.
# DATABASE_URL=postgres://user:password@host:5432/dbname
